{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acepilot.local/schemas/events/proactive-send-payload.schema.json",
  "title": "ProactiveSendPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetDate",
    "sequence",
    "requestedAt",
    "decisionSlot",
    "messageDedupeKey",
    "probability",
    "sample",
    "elapsedMinutes",
    "timeWeight",
    "characterRuntimeMode"
  ],
  "properties": {
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "decisionSlot": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "messageDedupeKey": {
      "type": "string",
      "pattern": "^PROACTIVE_MESSAGE:[0-9]{4}-[0-9]{2}-[0-9]{2}:[1-9][0-9]*$",
      "maxLength": 200
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sample": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1
    },
    "elapsedMinutes": {
      "type": "number",
      "minimum": 0
    },
    "timeWeight": {
      "type": "number",
      "minimum": 0
    },
    "characterRuntimeMode": {
      "enum": [
        "legacy",
        "enforced"
      ]
    },
    "characterBinding": {
      "$ref": "#/$defs/characterBinding"
    },
    "reason": {
      "enum": [
        "deterministic_probability_hit",
        "local_silence_threshold",
        null
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "characterRuntimeMode": {
            "const": "enforced"
          }
        },
        "required": [
          "characterRuntimeMode"
        ]
      },
      "then": {
        "required": [
          "characterBinding"
        ]
      },
      "else": {
        "not": {
          "required": [
            "characterBinding"
          ]
        }
      }
    }
  ],
  "$defs": {
    "characterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyVersion",
        "profileSchemaVersion",
        "profileRevision",
        "catalogVersion",
        "characterPackId",
        "characterPackVersion"
      ],
      "properties": {
        "policyVersion": {
          "const": "character-policy.v2"
        },
        "profileSchemaVersion": {
          "const": "character-profile.v2"
        },
        "profileRevision": {
          "type": "integer",
          "minimum": 1
        },
        "catalogVersion": {
          "const": "character-catalog.v2"
        },
        "characterPackId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "characterPackVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$"
        }
      }
    }
  }
}
