{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acepilot.local/schemas/events/diary-generate-payload.schema.json",
  "title": "DiaryGeneratePayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diaryDate",
    "requestedAt",
    "characterRuntimeMode"
  ],
  "properties": {
    "diaryDate": {
      "type": "string",
      "format": "date"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "characterRuntimeMode": {
      "type": "string",
      "enum": [
        "legacy",
        "enforced"
      ]
    },
    "characterBinding": {
      "$ref": "#/$defs/characterBinding"
    },
    "manualRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "originalEventId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "dependentRequired": {
    "manualRequestId": [
      "originalEventId"
    ],
    "originalEventId": [
      "manualRequestId"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "characterRuntimeMode": {
            "const": "enforced"
          }
        },
        "required": [
          "characterRuntimeMode"
        ]
      },
      "then": {
        "required": [
          "characterBinding"
        ]
      },
      "else": {
        "not": {
          "required": [
            "characterBinding"
          ]
        }
      }
    }
  ],
  "$defs": {
    "characterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileSchemaVersion",
        "profileRevision",
        "policyVersion",
        "catalogVersion",
        "characterPackId",
        "characterPackVersion"
      ],
      "properties": {
        "profileSchemaVersion": {
          "const": "character-profile.v2"
        },
        "profileRevision": {
          "type": "integer",
          "minimum": 1
        },
        "policyVersion": {
          "const": "character-policy.v2"
        },
        "catalogVersion": {
          "const": "character-catalog.v2"
        },
        "characterPackId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "characterPackVersion": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,79}$"
        }
      }
    }
  }
}
